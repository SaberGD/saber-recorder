{
  "manifest_version": 3,
  "name": "Saber Group Recorder",
  "short_name": "Saber Recorder",
  "version": "1.3.5",
  "description": "تسجيل المحاضرات أونلاين (الشاشة وصوت الجهاز والمايك) مع حفظ على الجهاز ورفع تلقائي على Drive الأكاديمية في فولدر المحاضرة.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Saber Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://us-central1-sg-tms-v2.cloudfunctions.net/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://training.sabergroupacademy.com/*"
    ]
  }
}
